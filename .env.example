# Copy to .env and adjust. Every value has a working default; this file
# documents what is tunable rather than what is required.

# --- PostgreSQL ------------------------------------------------------
QQ_DSN=postgresql://queryquest:queryquest@localhost:5432/queryquest
QQ_POOL_MIN=2
QQ_POOL_MAX=16
# Bound every statement and every lock wait. An unbounded statement is
# one runaway query away from taking the box with it.
QQ_STATEMENT_TIMEOUT_MS=120000
QQ_LOCK_TIMEOUT_MS=5000

# --- Redis -----------------------------------------------------------
QQ_REDIS_URL=redis://localhost:6379/0
QQ_CACHE_TTL_S=300
# Jitter as a fraction of the TTL. Stops keys written together from
# expiring together and stampeding the database on a schedule.
QQ_CACHE_TTL_JITTER=0.2
QQ_CACHE_LOCK_TIMEOUT_S=10
QQ_CACHE_ENABLED=true
QQ_CACHE_NS=qq

# --- ETL -------------------------------------------------------------
QQ_BATCH_ROWS=50000
# A chunk whose reject ratio exceeds this is rolled back and the batch
# is marked quarantined. Partial garbage is worse than no data.
QQ_MAX_REJECT_RATIO=0.02

# --- Concurrency -----------------------------------------------------
QQ_MAX_RETRIES=5
QQ_RETRY_BASE_MS=20

# --- Paths -----------------------------------------------------------
QQ_DATA_DIR=./data
QQ_REPORT_DIR=./reports
